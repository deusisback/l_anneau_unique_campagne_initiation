        </mxCell>
        <mxCell id="xgPK97w8zueCtZNx2T8O-119" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;les PJs se surprennent à fredonner les comptines de Tom Bombadil qu&#39;ils ont toutes retenues. Comme si les mots s&#39;étaient gravés dans leur esprit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
