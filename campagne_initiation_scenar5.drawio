        <mxCell id="xgPK97w8zueCtZNx2T8O-1" value="&lt;b&gt;Scénar 5 : &quot;Apaiser une bête sauvage&quot;&lt;/b&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;" vertex="1" parent="1">
          <mxGeometry x="-1490" y="525" width="150" height="80" as="geometry" />
