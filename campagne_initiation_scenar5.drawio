        <mxCell id="xgPK97w8zueCtZNx2T8O-89" value="&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;On ratera le test d&#39;exploration de Bilbo pour qu&#39;ils aient tous 1d de moins.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;On suppose qu&#39;un jet de chasse correspond à 1h de battue.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;Chaque échec produit un jet sur la table + 1 jet après 2 tests réussis&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
